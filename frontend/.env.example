# Network: studionet | localnet | testnetAsimov | testnetBradbury
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# RPC endpoint (Studio default). For testnet use the RPC of the chosen network.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Wallet network metadata (MetaMask add-network)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Address printed by `genlayer deploy`
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
